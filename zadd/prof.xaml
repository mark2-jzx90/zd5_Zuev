<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="zadd.prof"
             Title="Профиль"
             StyleClass="profile-page">

		<ContentPage.Resources>
			<StyleSheet Source="styles.css" />
		</ContentPage.Resources>

		<StackLayout Padding="30" Spacing="20" VerticalOptions="Center">
			<Label Text="Личный кабинет" StyleClass="profile-title" />

			<Frame BorderColor="#e94560" BackgroundColor="#0f3460" CornerRadius="15" Padding="20">
				<StackLayout>
					<Label Text="Пользователь:" StyleClass="profile-label" />
					<Label x:Name="lblUserName" Text="" StyleClass="profile-info" />
				</StackLayout>
			</Frame>

			<Button Text="Перейти к выбору"
					StyleClass="welcome-button"
					Clicked="OnGoToSelectionClicked" />
		</StackLayout>
</ContentPage>