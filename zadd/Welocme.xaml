<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="zdd.Welcome"
    Title="буду красбургером!">
	<StackLayout BackgroundColor="#Black">
		<Label Text="Welcome" FontSize="Medium" TextColor="#White"></Label>
		<Entry x:Name="txtName" BackgroundColor="#White" Placeholder="Введите имя" FontSize="Medium"></Entry>
		<Entry x:Name="txtPassword" BackgroundColor="#White" Placeholder="Введите пароль" FontSize="Medium"></Entry>
		<Button x:Name="SignIn" Text="SignIn" FontSize="Medium" BackgroundColor="#Red" TextColor="#White"></Button>
		<CheckBox x:Name="checkBox"></CheckBox>
		<Label Text="Remember me"></Label>
		<Label x:Name="Forgot" Text="I forgot!"></Label>
	</StackLayout>
</ContentPage>